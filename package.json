{
    "name": "addressimmo",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/sync-vite-output.mjs",
        "build:assets": "vite build && node scripts/sync-vite-output.mjs"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.6.4",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.0"
    },
    "hostingerDeploy": {
        "type": "laravel-assets",
        "outputDirectory": "build",
        "alternateOutputDirectories": ["public/build", "dist"],
        "note": "Laravel PHP : document root = public. Ce build compile uniquement les assets Vite."
    }
}
